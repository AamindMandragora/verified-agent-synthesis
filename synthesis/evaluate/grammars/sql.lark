// SQL grammar for CSD evaluation on Spider.
//
// Mirrors gsm.lark: outer delimiter is "<<" ... ">>" and csd_start consumes
// the closing delimiter. The constrained window contains one SQL statement.
//
// NAME is a single permissive identifier terminal used for tables, columns,
// and aliases — mirroring itergen's grammar shape. This avoids the LALR
// lexer ambiguity that comes with multiple same-regex terminals.

syncode: start

start: sql_stmt
csd_start: sql_stmt EOQ
EOQ: /[;\n]+/

sql_stmt: select_core (compound_op select_core)*

compound_op: "UNION"i ["ALL"i]
           | "INTERSECT"i
           | "EXCEPT"i

select_core: "SELECT"i [distinct] select_list "FROM"i from_list [where_clause] [group_clause] [order_clause] [limit_clause]

distinct: "DISTINCT"i

select_list: select_item ("," select_item)*
select_item: "*"                                          -> sel_star
           | table_ref "." "*"                            -> sel_table_star
           | value_expr [alias]                           -> sel_expr

alias: "AS"i identifier
     | identifier

from_list: table_source ("," table_source)*
table_source: table_primary (join_op table_primary ["ON"i bool_expr])*
table_primary: table_ref [alias]
             | "(" sql_stmt ")" [alias]
join_op: "JOIN"i | "INNER"i "JOIN"i | "LEFT"i ["OUTER"i] "JOIN"i | "RIGHT"i ["OUTER"i] "JOIN"i | "FULL"i ["OUTER"i] "JOIN"i | "CROSS"i "JOIN"i

where_clause: "WHERE"i bool_expr

group_clause: "GROUP"i "BY"i value_expr ("," value_expr)* [having_clause]
having_clause: "HAVING"i bool_expr

order_clause: "ORDER"i "BY"i order_item ("," order_item)*
order_item: value_expr [order_dir]
order_dir: "ASC"i | "DESC"i

limit_clause: "LIMIT"i NUMBER ["OFFSET"i NUMBER]

bool_expr: bool_and ("OR"i bool_and)*
bool_and: bool_not ("AND"i bool_not)*
bool_not: "NOT"i bool_not
        | bool_atom
bool_atom: value_expr comp_op value_expr                  -> cmp
         | value_expr "BETWEEN"i value_expr "AND"i value_expr -> between
         | value_expr ["NOT"i] "IN"i "(" in_rhs ")"         -> in_
         | value_expr ["NOT"i] "LIKE"i value_expr           -> like
         | value_expr "IS"i ["NOT"i] "NULL"i                 -> is_null
         | "EXISTS"i "(" sql_stmt ")"                      -> exists_
         | "(" bool_expr ")"                              -> bool_paren

in_rhs: value_expr ("," value_expr)*
      | sql_stmt

comp_op: "=" | "!=" | "<>" | "<=" | ">=" | "<" | ">"

value_expr: term (("+" | "-") term)*
term: factor (("*" | "/") factor)*
factor: agg_expr
      | "(" value_expr ")"
      | "(" sql_stmt ")"
      | column_expr
      | NUMBER
      | STRING
      | "NULL"i

agg_expr: agg_kw "(" [distinct] agg_arg ")"
agg_arg: "*" | value_expr

agg_kw: "COUNT"i | "SUM"i | "AVG"i | "MIN"i | "MAX"i

column_expr: table_ref "." column_ref
           | column_ref

// Identifiers (table names, column names, aliases) all share one terminal.
// Three separate same-regex terminals caused LALR ambiguity (lexer always picks
// the first-defined one), which broke alias-qualified refs like "T1.col FROM tbl AS T1".
// itergen takes the same approach: a single "name" rule used everywhere.
table_ref: NAME
column_ref: NAME
identifier: NAME

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

STRING: /'[^']*'/
NUMBER: /-?\d+(\.\d+)?/

%import common.WS_INLINE
%ignore WS_INLINE
// No -- comments: a comment swallows the rest of the line, so inside an answer span it
// can only ever be dead text after a finished query.
